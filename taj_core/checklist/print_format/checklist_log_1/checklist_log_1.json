 "html": "<div class=\"print-format\">\r\n    <style>\r\n        .header-table, .qa-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        .header-table td {\r\n            padding: 6px 8px;\r\n            border: 1px solid #d1d5db;\r\n            font-size: 12px;\r\n        }\r\n        .qa-table th, .qa-table td {\r\n            border: 1px solid #d1d5db;\r\n            padding: 8px;\r\n            vertical-align: top;\r\n        }\r\n        .qa-table th {\r\n            background: #f3f4f6;\r\n            font-weight: 700;\r\n        }\r\n        .title {\r\n            text-align: center;\r\n            margin-bottom: 12px;\r\n        }\r\n    </style>\r\n\r\n    <div class=\"title\">\r\n        <h2>Checklist Answer</h2>\r\n    </div>\r\n\r\n    <table class=\"header-table\" style=\"margin-bottom: 16px;\">\r\n        <tr>\r\n            <td><strong>Document No</strong><br>{{ doc.name }}</td>\r\n            <td><strong>Posting Date</strong><br>{{ doc.posting_date or \"-\" }}</td>\r\n            <td><strong>Status</strong><br>{{ doc.status or \"-\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><strong>Template</strong><br>{{ doc.template or \"-\" }}</td>\r\n            <td><strong>Department</strong><br>{{ doc.department or \"-\" }}</td>\r\n            <td><strong>Answer By</strong><br>{{ doc.answer_by or \"-\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"3\"><strong>Assigned User</strong><br>{{ doc.assigned_user or \"-\" }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <table class=\"qa-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 5%;\">#</th>\r\n                <th style=\"width: 60%;\">Question</th>\r\n                <th style=\"width: 35%;\">Answer</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for row in doc.answer %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ row.question_text or row.question }}</td>\r\n                <td>{{ row.answer or \"-\" }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n</div>",
