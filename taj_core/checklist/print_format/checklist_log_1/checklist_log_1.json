 "font_size": 14,
 "html": "<div class=\"print-format\">\n    <style>\n        .header-table, .qa-table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .header-table td {\n            padding: 6px 8px;\n            border: 1px solid #d1d5db;\n            font-size: 12px;\n        }\n        .qa-table th, .qa-table td {\n            border: 1px solid #d1d5db;\n            padding: 8px;\n            vertical-align: top;\n        }\n        .qa-table th {\n            background: #f3f4f6;\n            font-weight: 700;\n        }\n        .title {\n            text-align: center;\n            margin-bottom: 12px;\n        }\n    </style>\n\n    <div class=\"title\">\n        <h2>Checklist Answer</h2>\n    </div>\n\n    <table class=\"header-table\" style=\"margin-bottom: 16px;\">\n        <tr>\n            <td><strong>Document No</strong><br>{{ doc.name }}</td>\n            <td><strong>Posting Date</strong><br>{{ doc.posting_date or \"-\" }}</td>\n            <td><strong>Status</strong><br>{{ doc.status or \"-\" }}</td>\n        </tr>\n        <tr>\n            <td><strong>Template</strong><br>{{ doc.template or \"-\" }}</td>\n            <td><strong>Department</strong><br>{{ doc.department or \"-\" }}</td>\n            <td><strong>Answer By</strong><br>{{ doc.answer_by or \"-\" }}</td>\n        </tr>\n        <tr>\n            <td><strong>Assigned User</strong><br>{{ doc.assigned_user or \"-\" }}</td>\n            <td><strong>Asset</strong><br>{{ doc.asset or \"-\" }}</td>\n            <td><strong>Location</strong><br>{{ doc.plant_floor or doc.warehouse or \"-\" }}</td>\n        </tr>\n        {% if doc.production_started_before_completion %}\n        <tr>\n            <td colspan=\"3\">\n                <strong>Production Started Before Checklist Completion</strong><br>\n                Work Order: {{ doc.production_work_order or \"-\" }} |\n                Started At: {{ doc.production_started_at or \"-\" }} |\n                Completion: {{ doc.completion_percent_at_production_start or 0 }}%\n                {% if doc.incomplete_items_at_production_start %}\n                    <br><strong>Incomplete:</strong> {{ doc.incomplete_items_at_production_start }}\n                {% endif %}\n            </td>\n        </tr>\n        {% endif %}\n    </table>\n\n    <table class=\"qa-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 5%;\">#</th>\n                <th style=\"width: 60%;\">Question</th>\n                <th style=\"width: 35%;\">Answer</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.answer %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ row.question_text or row.question }}</td>\n                <td>\n                    <div><strong>{{ row.answer or \"-\" }}</strong></div>\n                    {% if row.has_issue %}\n                        <div style=\"margin-top:4px;\"><strong>Severity:</strong> {{ row.issue_severity or \"Medium\" }}</div>\n                        {% if row.quality_impact %}<div><strong>Quality Impact:</strong> Yes</div>{% endif %}\n                        {% if row.failure_reason %}<div><strong>Reason:</strong> {{ row.failure_reason }}</div>{% endif %}\n                        {% if row.user_note %}<div><strong>Note:</strong> {{ row.user_note }}</div>{% endif %}\n                        {% if row.require_follow_up %}<div><strong>Follow-up:</strong> {{ row.responsible_user or row.responsible_department or \"Required\" }}</div>{% endif %}\n                        {% if row.evidence_photo %}\n                            <div style=\"margin-top:6px;\"><img src=\"{{ row.evidence_photo }}\" alt=\"Evidence\" style=\"max-width:140px; max-height:100px; object-fit:contain;\"></div>\n                        {% endif %}\n                    {% endif %}\n                </td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>",
